      --camera-make <CAMERA_MAKE>    
      --session <FILE>               Session file (default: ~/Library/Caches/app.quadcam/session.json)
      --camera-model <CAMERA_MODEL>  
      --video-system <VIDEO_SYSTEM>  Analog, DJI O4, Walksnail, HDZero, ...
      --keywords <KEYWORDS>          Comma-separated; replaces the list
      --author <AUTHOR>              
      --place <PLACE>                A saved place name ("" for none)
      --models <MODELS>              EdgeTX model names, comma-separated; replaces the list
      --rename <RENAME>              New name for the profile
      --default                      Also make it the default profile
  -h, --help                         Print help
