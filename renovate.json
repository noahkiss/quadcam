{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>noahkiss/renovate-config"
  ],
  "packageRules": [
    {
      "description": "The e2e job's Playwright image must match @playwright/test, so both move in one pull request, which automerges like @playwright/test alone did.",
      "matchPackageNames": ["@playwright/test", "mcr.microsoft.com/playwright"],
      "groupName": "playwright"
    },
    {
      "matchPackageNames": ["mcr.microsoft.com/playwright"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": false
    }
  ]
}
